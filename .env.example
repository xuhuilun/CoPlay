# ─────────────────────────────────────────────────────────────────────────────
# CoPlay environment. Copy to .env and fill in. Empty optional blocks stay disabled.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──
NODE_ENV=development
API_PORT=4000
# CORS: single origin, or WEB_ORIGINS as a comma-separated allowlist (takes precedence)
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173
# Web build-time endpoints (baked into the SPA by Vite)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# ── Persistence & realtime drivers ──
# memory = in-process (dev); prisma/redis = durable + horizontally scalable (prod)
PERSISTENCE_DRIVER=memory
SOCKET_ADAPTER=memory
# Required when PERSISTENCE_DRIVER=prisma. MySQL 8. Run migrations: npm run prisma:migrate -w apps/api
DATABASE_URL=mysql://coplay:coplay_password@localhost:3306/coplay
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=coplay
MYSQL_USER=coplay
MYSQL_PASSWORD=coplay_password
# Required when SOCKET_ADAPTER=redis
REDIS_URL=redis://redis:6379

# ── Rate limiting ──
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ── Public CDN domain for playback URLs (player requests video directly from here) ──
# Aliyun CDN/DCDN domain bound to the OSS bucket. Falls back to the OSS bucket endpoint if unset.
CDN_BASE_URL=https://cdn.bilisync.top

# ── Cache download backend ──
# simulated (default, no external tools) | ytdlp (real download; needs the yt-dlp binary)
CACHE_DOWNLOADER=simulated
YTDLP_BINARY=yt-dlp

# ── Aliyun OSS upload (optional; all four required to enable — pair with CACHE_DOWNLOADER=ytdlp) ──
# Create a bucket at https://oss.console.aliyun.com and a RAM sub-account with oss:PutObject/
# oss:InitiateMultipartUpload/... scoped to it at https://ram.console.aliyun.com (least privilege).
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# Region id, e.g. cn-hongkong / cn-shanghai (with or without the oss- prefix)
OSS_REGION=cn-hongkong
# true when the API runs inside the same Aliyun region as the bucket (uses the intranet endpoint, no egress cost)
OSS_INTERNAL=false
# Optional explicit endpoint override; takes precedence over region/internal
OSS_ENDPOINT=

# ── GitHub OAuth login (optional; client id + redirect uri enable the provider, secret enables the callback) ──
# Register an OAuth App at https://github.com/settings/developers. Set the Authorization callback URL
# to exactly GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://bilisync.top/auth/github/callback

# ── Smoke test (scripts/smoke.mjs; see docs) ──
SMOKE_API_BASE=http://localhost:4000/api
# A real, short, public Bilibili video URL to exercise the download→hash→upload chain
SMOKE_BILIBILI_URL=https://www.bilibili.com/video/BV1GJ411x7h7
SMOKE_TIMEOUT_MS=120000
