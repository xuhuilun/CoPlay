NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=coplay
MYSQL_USER=coplay
MYSQL_PASSWORD=coplay_password
DATABASE_URL=mysql://coplay:coplay_password@localhost:3306/coplay
REDIS_URL=redis://redis:6379
CDN_BASE_URL=https://cdn.bilisync.top
PERSISTENCE_DRIVER=memory
SOCKET_ADAPTER=memory
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Optional GitHub OAuth login (client id + redirect uri enable the provider; secret enables the callback token exchange)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://bilisync.top/auth/github/callback
